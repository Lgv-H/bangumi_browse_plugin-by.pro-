{
  "manifest_version": 2,
  "id": "github.lgv-h.bangumi-browse-plugin-by.pro",
  "version": "1.0.1",
  "name": "Bangumi 动漫高手插件 · 反代版",
  "description": "接入 Bangumi (bgm.tv)，让你的 MaiBot 变身动画高手！支持新番速览、每日放送、单集吐槽、长评阅读、制作阵容查询，动画/游戏/书籍一网打尽。本版经 bangumi.pro 反代访问，大陆网络无需代理即可使用。",
  "author": {
    "name": "Lgv-H",
    "url": "https://github.com/Lgv-H"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Lgv-H/bangumi_browse_plugin-by.pro-",
    "homepage": "https://github.com/Lgv-H/bangumi_browse_plugin-by.pro-",
    "documentation": "https://github.com/Lgv-H/bangumi_browse_plugin-by.pro-/blob/main/README.md",
    "issues": "https://github.com/Lgv-H/bangumi_browse_plugin-by.pro-/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.25.0"
    },
    {
      "type": "python_package",
      "name": "beautifulsoup4",
      "version_spec": ">=4.11.0"
    },
    {
      "type": "python_package",
      "name": "lxml",
      "version_spec": ">=4.9.0"
    }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
